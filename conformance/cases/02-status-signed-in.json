{
  "name": "status reads the profile with the stored token",
  "args": [
    "status",
    "--json"
  ],
  "credentials": {
    "default": {
      "access_token": "tok-file",
      "refresh_token": "ref-1",
      "expires_at": 4102444800
    }
  },
  "mocks": [
    {
      "method": "GET",
      "path": "/api/v1/me",
      "body": {
        "id": "prf_1",
        "email": "ada@example.com",
        "name": "Ada",
        "nickname": "Ada"
      },
      "expect_headers": {
        "authorization": "Bearer tok-file"
      }
    }
  ],
  "expect": {
    "exit": 0,
    "json": {
      "signed_in": true,
      "email": "ada@example.com",
      "profile_id": "prf_1",
      "token_source": "file"
    },
    "never_contains": [
      "tok-file"
    ]
  }
}
